# ═══════════════════════════════════════════════════
#  宝宝闯关 · 环境变量示例
# ═══════════════════════════════════════════════════
# 复制为 .env 并填入真实值
# cp .env.example .env

# ─── 服务器 ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── 认证 / 短信 ─────────────────────────────────────
# ⚠️ 重要：阿里云/腾讯云短信 *尚未接入真实发送*。
#    SMS_PROVIDER=aliyun 或 tencent 在生产环境会返回 503。
#    要测试登录流程，请使用 development 模式。
#
# 短信供应商:
#   development — 验证码打印到终端 + 前端弹窗显示（仅供本地开发）
#   aliyun      — ⚠️ 未接入，生产环境不可用
#   tencent     — ⚠️ 未接入，生产环境不可用
SMS_PROVIDER=development

# 开发模式：验证码会在后端终端显示，并在前端弹窗显示"本地开发验证码"
# 无需真实短信费用即可完整测试登录流程

# ── 阿里云短信（SMS_PROVIDER=aliyun 时需要） ──
# ⚠️ 以下配置仅作占位，阿里云短信 *尚未实现*。
# 设置 SMS_PROVIDER=aliyun 会抛出错误，请勿在生产环境使用。
# SMS_ALIYUN_ACCESS_KEY_ID=your_access_key_id
# SMS_ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
# SMS_ALIYUN_SIGN_NAME=宝宝闯关
# SMS_ALIYUN_TEMPLATE_CODE=SMS_123456789

# ── 腾讯云短信（SMS_PROVIDER=tencent 时需要） ──
# ⚠️ 以下配置仅作占位，腾讯云短信 *尚未实现*。
# 设置 SMS_PROVIDER=tencent 会抛出错误，请勿在生产环境使用。
# SMS_TENCENT_SECRET_ID=your_secret_id
# SMS_TENCENT_SECRET_KEY=your_secret_key
# SMS_TENCENT_SDK_APP_ID=1400000000
# SMS_TENCENT_SIGN_NAME=宝宝闯关
# SMS_TENCENT_TEMPLATE_ID=1234567

# ── Session 配置 ────────────────────────────────────
# Session 密钥：用于签名/验证 session cookie（生产环境必填）
# 使用 openssl rand -hex 32 生成
# SESSION_SECRET=your_session_secret_random_hex_string

# Session 有效期（天），默认 30 天
# SESSION_MAX_DAYS=30

# ── 限流配置 ────────────────────────────────────────
# 同手机号最大发送次数，默认 5
# PHONE_MAX_SENDS=5
# 发送窗口期（分钟），默认 15
# PHONE_WINDOW_MINUTES=15
# 发送冷却时间（秒），默认 60
# PHONE_COOLDOWN_SECONDS=60
# 验证码有效期（分钟），默认 5
# CODE_EXPIRY_MINUTES=5
# 验证码最大尝试次数，默认 3
# CODE_MAX_ATTEMPTS=3
# IP 限流：窗口期内最大请求数，默认 20
# IP_RATE_LIMIT_MAX=20
# IP 限流窗口（分钟），默认 15
# IP_RATE_LIMIT_WINDOW_MINUTES=15

# ── CORS 配置 ────────────────────────────────────────
# 允许的来源（逗号分隔，可选）
# 默认允许: localhost, 127.0.0.1, null origin (file://)
# CORS_ORIGINS=http://myapp.com,https://myapp.com

# ─── 豆包 TTS (Sprint 1) ─────────────────────────────
DOUBAO_APP_ID=
DOUBAO_TOKEN=
DOUBAO_CLUSTER=
DOUBAO_VOICE_TYPE=
