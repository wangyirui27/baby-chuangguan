# ═══════════════════════════════════════════════════
#  宝宝闯关 · 环境变量示例
# ═══════════════════════════════════════════════════
# 复制为 .env 并填入真实值
# cp .env.example .env

# ─── 服务器 ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── 认证 / 短信 ─────────────────────────────────────
# 短信供应商:
#   development — 验证码打印到终端 + 前端弹窗显示（本地开发）
#   aliyun      — 阿里云短信（需填下方凭据；代码已接入）
#
# 本地开发默认:
SMS_PROVIDER=development

# ── 阿里云短信（SMS_PROVIDER=aliyun 时必填） ──
# 控制台: https://dysms.console.aliyun.com/
# 1) RAM 创建 AccessKey
# 2) 开通短信服务，申请签名 + 模板（模板变量默认 ${code}）
# 3) 将下列值填入 .env（切勿提交真实凭据）
#
# SMS_ALIYUN_ACCESS_KEY_ID=your_access_key_id
# SMS_ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
# SMS_ALIYUN_SIGN_NAME=宝宝闯关
# SMS_ALIYUN_TEMPLATE_CODE=SMS_123456789
#
# 可选:
# SMS_ALIYUN_REGION_ID=cn-hangzhou
# SMS_ALIYUN_ENDPOINT=https://dysmsapi.aliyuncs.com/
# 模板 JSON 变量名，默认 code → {"code":"123456"}
# SMS_ALIYUN_TEMPLATE_PARAM_KEY=code

# ── Session 配置 ────────────────────────────────────
# SESSION_SECRET=your_session_secret_random_hex_string
# SESSION_MAX_DAYS=30

# ── 限流配置 ────────────────────────────────────────
# PHONE_MAX_SENDS=5
# PHONE_WINDOW_MINUTES=15
# PHONE_COOLDOWN_SECONDS=60
# CODE_EXPIRY_MINUTES=5
# CODE_MAX_ATTEMPTS=3
# IP_RATE_LIMIT_MAX=20
# IP_RATE_LIMIT_WINDOW_MINUTES=15

# ── CORS 配置 ────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,https://myapp.com

# ── InsForge 学习数据后端（服务端专用，禁止前端暴露）────
# INSFORGE_URL=https://your-appkey.region.insforge.app
# INSFORGE_API_KEY=server_only_project_api_key

# ─── 虚拟登录（本地测试）─────────────────────────────
# development/test 默认开启：任意 11 位手机号 + 验证码 1234 即可登录（无需发短信）
# VIRTUAL_LOGIN=0            # 关闭
# VIRTUAL_LOGIN_CODE=1234    # 改虚拟码
# 生产默认关闭；若必须开启：ALLOW_VIRTUAL_LOGIN=1（不推荐）

# ─── 豆包 TTS (Sprint 1) ─────────────────────────────
DOUBAO_APP_ID=
DOUBAO_TOKEN=
DOUBAO_CLUSTER=
DOUBAO_VOICE_TYPE=
