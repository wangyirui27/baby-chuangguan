# ─── Dependencies ──────────────────────────────────
node_modules/
*/node_modules/

# ─── Environment / Secrets ─────────────────────────
.env
.env.*
!.env.example

# ─── Runtime data (generated JSON) ──────────────────
data/*.json
!data/.gitkeep

# ─── Build output ─────────────────────────────────
dist/
build/
.out/

# ─── Temporary files ───────────────────────────────
*.tmp
*.temp
*.log
*.lock

# ─── OS files ──────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor directories ────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── MSW service worker cache ─────────────────────
.msw/

# ─── Alma metadata & snapshots ────────────────────
.alma/
.alma-snapshots/

# ─── LibTV metadata ────────────────────────────────
.libtv/

# ─── Screenshots (verification artifacts) ──────────
*.png
!assets/**/*.webp
*.jpg
*.jpeg
# Allow runtime jpg/jpeg in assets (none currently needed)

# ─── PinchTab / browser test artifacts ─────────────
pinchtab-*

# ─── Preview/standalone HTML test pages ─────────────
voice-samples.html
voice-samples-v2.html
preview-word-audio.png
mobile-state-check.png
_verify_button.mjs

# ─── Generated source assets (intermediate AI output, not runtime) ──
assets/generated/
