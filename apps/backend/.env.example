# ─── apps/backend — Environment Variables ─────────────────────────────────
# Copy this file to .env for local development.
# NEVER commit .env with real credentials.

# ── Server ────────────────────────────────────────────────────────────────
# Port for the API server (default: 3000)
PORT=3000

# Node environment: development | production | staging | test
NODE_ENV=development

# ── Authentication Repository ─────────────────────────────────────────────
# Currently only "memory" is supported.
# DATABASE_URL is a future boundary only — do NOT set in production yet.
AUTH_REPOSITORY=memory
# DATABASE_URL=postgresql://user:password@localhost:5432/baby_island

# ── SMS Provider ─────────────────────────────────────────────────────────
# development  — prints codes to console (local dev only)
# aliyun       — 阿里云短信（not yet implemented）
# tencent      — 腾讯云短信（not yet implemented）
SMS_PROVIDER=development

# ── Session ───────────────────────────────────────────────────────────────
# Session duration in days (default: 30)
# SESSION_MAX_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (default: localhost, 127.0.0.1)
# CORS_ORIGINS=http://localhost:5173,https://myapp.com

# ── Rate Limiting (frozen values — do not change) ───────────────────────
# PHONE_COOLDOWN_SECONDS=60
# PHONE_MAX_SENDS=5
# PHONE_WINDOW_MINUTES=15
# CODE_EXPIRY_MINUTES=5
# CODE_MAX_ATTEMPTS=3
# IP_RATE_LIMIT_MAX=20
# IP_RATE_LIMIT_WINDOW_MINUTES=15
