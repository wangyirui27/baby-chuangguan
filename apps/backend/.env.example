# ─── apps/backend — Environment Variables ─────────────────────────────────
# Copy this file to .env for local development.
# NEVER commit .env with real credentials.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Authentication Repository ─────────────────────────────────────────────
# Currently only "memory" is supported.
AUTH_REPOSITORY=memory
# DATABASE_URL=postgresql://user:***@localhost:5432/baby_island

# ── SMS Provider ─────────────────────────────────────────────────────────
# development  — prints codes to console (local dev only)
# aliyun       — 阿里云短信（代码已接入，需下方凭据）
SMS_PROVIDER=development

# ── 阿里云短信（SMS_PROVIDER=aliyun 时必填） ──
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=
# SMS_ALIYUN_TEMPLATE_PARAM_KEY=code
# SMS_ALIYUN_REGION_ID=cn-hangzhou
# SMS_ALIYUN_ENDPOINT=https://dysmsapi.aliyuncs.com/

# ── Session ───────────────────────────────────────────────────────────────
# SESSION_MAX_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,https://myapp.com

# ── Rate Limiting (frozen values — do not change) ───────────────────────
# PHONE_COOLDOWN_SECONDS=60
# PHONE_MAX_SENDS=5
# PHONE_WINDOW_MINUTES=15
# CODE_EXPIRY_MINUTES=5
# CODE_MAX_ATTEMPTS=3
# IP_RATE_LIMIT_MAX=20
# IP_RATE_LIMIT_WINDOW_MINUTES=15
