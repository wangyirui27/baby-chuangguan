{
  "name": "@baby-island/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Contract-backed authentication API for 宝宝闯关",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:contract": "node --test test/contract.test.js",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/service/auth-service.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^4.21.0"
  }
}
