# ═══════════════════════════════════════════════════════════════
#  宝宝英语岛 · Frontend workspace 环境变量
# ═══════════════════════════════════════════════════════════════
# 复制到 .env.local 填入真实值
# cp .env.example .env.local

# ─── API 运行模式 ─────────────────────────────────────────────
# mock  — /api/* 代理到 localhost:3001（独立 Mock Server）
# real  — /api/* 代理到 localhost:3000（真实后端）
VITE_API_MODE=mock

# ─── Real 模式下后端地址（仅 real 模式使用）──────────────────
# Mock 模式忽略此变量，固定使用 localhost:3001。
VITE_API_BASE_URL=http://localhost:3000

# ─── 调试 ─────────────────────────────────────────────────────
# 设为 1 开启 proxy 请求日志（开发诊断用）
# VITE_DEBUG_PROXY=0
