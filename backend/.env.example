# ─── 豆包 TTS 配置 ───────────────────────────────────────
# 所有值从火山引擎控制台获取：https://console.volcengine.com/speech/app
# ⚠️ 严禁在代码、日志、commit message 中出现真实凭据

# [必填] 应用 ID
DOUBAO_APP_ID=your_app_id_here

# [必填] Access Token — 仅用于 Authorization: Bearer;{token}
DOUBAO_TOKEN=your_access_token_here

# [必填] 业务集群 — 标准音色用 volcano_tts，大模型音色用 volcano_mega
DOUBAO_CLUSTER=volcano_tts

# [兼容旧脚本] 音色 ID — 当前生成器在代码中固定：海岛 Natasha / 沙漠 Hayley
DOUBAO_VOICE_TYPE=en_female_natasha_uranus_bigtts

# [可选] 采样率，默认 24000
DOUBAO_SAMPLE_RATE=24000

# [可选] 音频格式，默认 mp3
DOUBAO_AUDIO_FORMAT=mp3

# ─── 短信（认证登录）───────────────────────────────────
# development | aliyun
SMS_PROVIDER=development
# 生产/真短信：SMS_PROVIDER=aliyun，密钥与签名复用影关（movie-game）阿里云 Dysms：墨斗曲线 + 验证码模板

# 阿里云（SMS_PROVIDER=aliyun 时必填）
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=
# SMS_ALIYUN_TEMPLATE_PARAM_KEY=code

# ─── InsForge 学习数据后端（服务端专用）───────────────
# INSFORGE_URL=https://your-appkey.region.insforge.app
# INSFORGE_API_KEY=server_only_project_api_key

# Admin console (/admin) bearer token
ADMIN_TOKEN=

# 视频 CDN / OSS 公网前缀（admin 关卡目录；也可只在 content-catalog 里配）
OSS_PUBLIC_BASE_URL=
# COURSE_VIDEO_BASE=
