{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/user.json",
  "title": "User",
  "type": "object",
  "required": ["id", "normalizedPhone", "createdAt", "lastLoginAt", "isLoggedIn", "hasFullAccess"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "User unique identifier (crypto.randomUUID)"
    },
    "normalizedPhone": {
      "type": "string",
      "description": "E.164 normalized phone with +86 prefix",
      "pattern": "^\\+86\\d{11}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "lastLoginAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "isLoggedIn": {
      "type": "boolean",
      "const": true
    },
    "hasFullAccess": {
      "type": "boolean",
      "description": "Always false currently. Payment not yet implemented."
    }
  },
  "additionalProperties": false
}
