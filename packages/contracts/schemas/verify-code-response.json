{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/verify-code-response.json",
  "title": "VerifyCodeResponse",
  "type": "object",
  "required": ["token", "user"],
  "properties": {
    "token": {
      "type": "string",
      "description": "64 hex char session token",
      "minLength": 64,
      "maxLength": 64
    },
    "user": { "$ref": "user.json" }
  },
  "additionalProperties": false
}
