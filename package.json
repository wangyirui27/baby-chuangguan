{
  "name": "baby-island-quest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test quiz.test.js ambient-sfx.test.js voice-samples-v2.test.js generate-word-audio-v2.test.js native-shell.test.js auth/apiClient.local-mock.test.cjs backend/src/*.test.js apps/backend/test/*.test.js apps/frontend/tests/api-client.test.cjs",
    "start": "cd backend && npm start",
    "e2e": "node tools/e2e-auth-flow.mjs",
    "audit:readiness": "node tools/audit-readiness.mjs",
    "audit:release": "node tools/audit-readiness.mjs --strict",
    "generate:contracts": "node tools/contracts/generate.mjs",
    "generate:question-audio": "node backend/src/generate-question-audio-v2.js",
    "validate:contracts": "node tools/contracts/validate.mjs",

    "frontend:dev:mock": "cd apps/frontend && npm run dev:mock",
    "frontend:dev:real": "cd apps/frontend && npm run dev:real",
    "frontend:mock:server": "cd apps/frontend && npm run mock:server",
    "frontend:build": "cd apps/frontend && npm run build",
    "frontend:test": "cd apps/frontend && npm run test",
    "frontend:test:mock": "cd apps/frontend && npm run test:mock",
    "frontend:smoke": "cd apps/frontend && npm run test:smoke"
  },
  "devDependencies": {
    "playwright": "^1.61.0"
  }
}
