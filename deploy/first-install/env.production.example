# Copy to /etc/baobao-backend.env (chmod 640, root:baobao).
# FILL values on the server. Never commit real secrets.

NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://example.com

SMS_PROVIDER=aliyun
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_TEMPLATE_PARAM_KEY=code
VIRTUAL_LOGIN=0
SMS_DEV_FALLBACK=0

AUTH_REPOSITORY=mysql
LEARNING_REPOSITORY=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=baobao_chuangguan
MYSQL_CONNECTION_LIMIT=5

ADMIN_TOKEN=
# OSS_PUBLIC_BASE_URL=
